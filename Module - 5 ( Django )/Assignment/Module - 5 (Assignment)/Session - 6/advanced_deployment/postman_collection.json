    {"name":"Send SMS","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"phone\": \"+919999999999\",\n  \"message\": \"Welcome!\"\n}"},"url":"{{base_url}}/api/v1/send-sms/"}},
    {"name":"Payment","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"amount\": 500,\n  \"currency\": \"usd\"\n}"},"url":"{{base_url}}/api/v1/payment/"}},
    {"name":"Google Login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"access_token\": \"GOOGLE_ACCESS_TOKEN\"\n}"},"url":"{{base_url}}/api/v1/google-login/"}},
    {"name":"Email V2","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"email\": \"user@example.com\"\n}"},"url":"{{base_url}}/api/v2/send-email/"}}
  ]
